[Unit]
Description=Check whether either MUDFinder instance has something to deploy
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
# Only the token lives here. It needs no scopes beyond public read; the
# githubrelease resource requires one even for a public repository.
EnvironmentFile=/etc/mudfinder/updatecli.env

# Both manifests in one run. Each writes a file and nothing more -- the deploy
# is a separate unit, triggered by that file changing.
ExecStart=/usr/bin/updatecli apply --config /opt/mudfinder-deploy/updatecli/beta.yaml
ExecStart=/usr/bin/updatecli apply --config /opt/mudfinder-deploy/updatecli/primary.yaml
