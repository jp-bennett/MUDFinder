# /etc/mudfinder/beta.env

# host:port for gunicorn to bind. 127.0.0.1 when nginx is on this machine;
# 0.0.0.0 when it is on another one, since loopback is not routable from there
# and the symptom is a 502 from nginx while curl on the host returns 200.
#
# Binding 0.0.0.0 puts the instance in front of anything that can reach this
# machine, so pair it with a firewall rule allowing only the proxy.
MUDFINDER_BIND=0.0.0.0:5001

# Served at /beta by nginx, which strips the prefix. The app has to be told,
# because the Socket.IO client builds its URL from the origin and an absolute
# path -- see "Serving it under a subpath" in the README.
MUDFINDER_BASE_PATH=/beta
